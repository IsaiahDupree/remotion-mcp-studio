              "type": "string"
            },
            {
              "id": "best_music_name",
              "name": "best_music_name",
              "value": "={{ $json.music_recommendations.best_match.music_name }}",
              "type": "string"
            },
            {
              "id": "compatibility_score",
              "name": "compatibility_score",
              "value": "={{ $json.music_recommendations.best_match.compatibility_score }}",
              "type": "number"
            },
            {
              "id": "mood_match",
              "name": "mood_match",
              "value": "={{ $json.music_recommendations.best_match.mood_match }}",
              "type": "string"
            },
            {
              "id": "energy_match",
              "name": "energy_match",
              "value": "={{ $json.music_recommendations.best_match.energy_match }}",
              "type": "string"
            },
            {
              "id": "theme_match",
              "name": "theme_match",
              "value": "={{ $json.music_recommendations.best_match.theme_match }}",
              "type": "string"
            },
            {
              "id": "total_tracks_analyzed",
              "name": "total_tracks_analyzed",
              "value": "={{ $json.music_recommendations.total_tracks_analyzed }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "extract_music_data",
      "name": "📊 Extract Music Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "compatibility_check",
              "leftValue": "={{ $json.compatibility_score }}",
              "rightValue": "={{ $json.min_compatibility_score }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "compatibility_check",
      "name": "✅ Check Compatibility",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.flask_api_base }}/process/smart-video",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "video_filename",
              "value": "={{ $json.video_filename }}"
            },
            {
              "name": "music_path",
              "value": "={{ $json.best_music_path }}"
            },
            {
              "name": "config",
              "value": "={{ {\n  \"music_volume\": $json.music_volume_linear,\n  \"text_style\": $json.text_style,\n  \"min_compatibility_score\": $json.min_compatibility_score\n} }}"
            }
          ]
        },
        "options": {}
      },
      "id": "process_video",
      "name": "🎬 Process Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "output_filename",
              "name": "output_filename",
              "value": "={{ $json.output_filename }}",
              "type": "string"
            },
            {
              "id": "download_url",
              "name": "download_url",
              "value": "={{ $json.download_url }}",
              "type": "string"
            },
            {
              "id": "processing_time",
              "name": "processing_time",
              "value": "={{ $json.processing_time_seconds }}",
              "type": "number"
            },
            {
              "id": "text_overlay_used",
              "name": "text_overlay_used",
              "value": "={{ $json.text_overlay }}",
              "type": "string"
            },
            {
              "id": "full_download_url",
              "name": "full_download_url",
              "value": "={{ $json.flask_api_base }}{{ $json.download_url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract_results",
      "name": "📤 Extract Results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "url": "={{ $json.full_download_url }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "file",
              "outputPropertyName": "enhanced_video_file"
            }
          }
        }
      },
      "id": "download_video",
      "name": "⬇️ Download Enhanced Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "final_summary",
              "name": "final_summary",
              "value": "=🎉 VIDEO ENHANCEMENT COMPLETE!\n\n📹 Original Video: {{ $json.video_filename }}\n🎵 Music Added: {{ $json.best_music_name }}\n🔊 Volume Level: {{ $json.music_volume_db }}dB ({{ $json.music_volume_linear }} linear)\n💯 Compatibility Score: {{ $json.compatibility_score }}/1.0\n📝 Text Overlay: {{ $json.text_overlay_used }}\n⏱️ Processing Time: {{ $json.processing_time }}s\n📁 Output File: {{ $json.output_filename }}\n🔗 Download URL: {{ $json.full_download_url }}\n\n✨ Music Match Analysis:\n- Mood Match: {{ $json.mood_match }}\n- Energy Match: {{ $json.energy_match }}\n- Theme Match: {{ $json.theme_match }}\n- Total Tracks Analyzed: {{ $json.total_tracks_analyzed }}",
              "type": "string"
            },
            {
              "id": "success_flag",
              "name": "success_flag",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "final_summary",
      "name": "📋 Final Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2220, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "error_message",
              "name": "error_message",
              "value": "❌ COMPATIBILITY TOO LOW!\n\nThe best music match has a compatibility score of {{ $json.compatibility_score }}, which is below the minimum threshold of {{ $json.min_compatibility_score }}.\n\n🎵 Best Available Match:\n- Music: {{ $json.best_music_name }}\n- Compatibility: {{ $json.compatibility_score }}/1.0\n- Mood Match: {{ $json.mood_match }}\n- Energy Match: {{ $json.energy_match }}\n- Theme Match: {{ $json.theme_match }}\n\n💡 Suggestions:\n1. Lower the minimum compatibility score\n2. Add more music tracks to your library\n3. Process the video manually with the current best match",
              "type": "string"
            },
            {
              "id": "success_flag",
              "name": "success_flag",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "compatibility_error",
      "name": "⚠️ Compatibility Too Low",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1560, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success_check",
              "leftValue": "={{ $json.success_flag }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "final_check",
      "name": "🏁 Final Status Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "message": "={{ $json.final_summary }}",
        "options": {}
      },
      "id": "success_notification",
      "name": "✅ Success Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [2660, 200],
      "disabled": true
    },
    {
      "parameters": {
        "message": "={{ $json.error_message }}",
        "options": {}
      },
      "id": "error_notification",
      "name": "❌ Error Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [2660, 400],  
      "disabled": true
    }
