FROM python:3.11-slim

# Install system dependencies including FFmpeg
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY minimal_requirements.txt ./
RUN pip install --no-cache-dir -r minimal_requirements.txt

# Create necessary directories
RUN mkdir -p /app/cache /tmp/video-analysis /tmp/video-processing /srv/cache/output

# Copy Python files
COPY minimal_flask_api.py ./

# Set environment variables
ENV PYTHONPATH=/app
ENV FLASK_APP=minimal_flask_api.py
ENV FLASK_ENV=production
ENV PYTHONUNBUFFERED=1

# Expose port 5001
EXPOSE 5001

# Start the Flask application with gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "1", "--timeout", "300", "minimal_flask_api:app"]
