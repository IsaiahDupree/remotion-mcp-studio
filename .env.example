# ══════════════════════════════════════════════════════════════════════════════
# Remotion MCP Studio v2.0 — Environment Variables
# Merged from: ai-video-platform + remotion-tiktok-pipeline + content-ai-pipeline + custom-video-tools
# Copy to .env and fill in your API keys
# ══════════════════════════════════════════════════════════════════════════════

# ── AI Content Pipeline ───────────────────────────────────────────────────────
# Claude API (script generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity API (topic research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ElevenLabs API (voice synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB

# OpenAI (Python services: text overlay, music analysis)
OPENAI_API_KEY=your_openai_api_key_here

# ── Modal Cloud Rendering ─────────────────────────────────────────────────────
MODAL_REMOTION_RENDER_URL=
MODAL_REMOTION_THUMBNAIL_URL=
MODAL_VOICE_CLONE_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ivhfuhxorppptyuofbgq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Publishing (Blotato) ─────────────────────────────────────────────────────
BLOTATO_API_KEY=your_blotato_api_key_here
BLOTATO_BASE_URL=https://backend.blotato.com/v2

# Platform Account IDs (Blotato)
BLOTATO_YOUTUBE_ACCOUNT_ID=228
BLOTATO_TIKTOK_ACCOUNT_ID=710
BLOTATO_INSTAGRAM_ACCOUNT_ID=807
BLOTATO_LINKEDIN_ACCOUNT_ID=your_linkedin_account_id_here
BLOTATO_TWITTER_ACCOUNT_ID=571

# ── Auth & Security ───────────────────────────────────────────────────────────
SCRIPT_API_SECRET=your_script_api_secret_here
ADMIN_RELOAD_TOKEN=your_admin_reload_token_here
APPROVAL_SECRET=your_approval_secret_here

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_api_key_here
LOG_LEVEL=info
NEXT_PUBLIC_BASE_URL=http://localhost:3000
